/*
  Permissions-Policy: interest-cohort=(), geolocation=(), microphone=(), camera=()
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Content-Security-Policy: default-src 'self'; script-src 'self' https://static.cloudflareinsights.com; style-src 'self'; img-src 'self' data:; media-src 'self'; connect-src 'self' https://blog.illixion.com https://apps.illixion.com https://cloudflareinsights.com; frame-src https://github.com; worker-src 'self'; manifest-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'

https://illixion.pages.dev/*
  X-Robots-Tag: noindex

/sw.js
  Cache-Control: no-cache

/site.webmanifest
  Content-Type: application/manifest+json

# Web Key Directory, so `gpg --locate-keys illixion@illixion.com` finds pgp.txt's key.
/.well-known/openpgpkey/*
  Access-Control-Allow-Origin: *
  Content-Type: application/octet-stream
